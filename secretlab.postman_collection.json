{
  "info": {
    "name": "Secretlab API",
    "description": "Run requests in order. The first request creates a new test key and saves its timestamp. The second waits for a different timestamp. Latest should return value2; history should return value1. Records remain in the database. For local testing set base_url to http://localhost:8000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://secretlab-production.up.railway.app",
      "type": "string"
    },
    {
      "key": "key",
      "value": "postman-example",
      "type": "string"
    },
    {
      "key": "timestamp",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Save first value",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/object",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"{{key}}\": \"value1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"key\", \"postman-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set(\"timestamp\", pm.response.json().timestamp);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Save second value",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/object",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"{{key}}\": \"value2\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "setTimeout(function () {}, 1100);"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Get latest value",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/object/{{key}}"
      },
      "response": []
    },
    {
      "name": "4. Get value at first timestamp",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/object/{{key}}?timestamp={{timestamp}}"
      },
      "response": []
    },
    {
      "name": "5. List all records",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/object/get_all_records"
      },
      "response": []
    }
  ]
}
